{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "AfuDM",
      "changelog-path": "docs/RELEASE_NOTES/CHANGELOG.md",
      "include-v-in-tag": true,
      "skip-github-release": true,
      "extra-files": [
        "core/surum.py",
        "extension/manifest.json",
        {
          "type": "toml",
          "path": "rs/Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "rs/app/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "rs/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-types')].version"
        },
        {
          "type": "toml",
          "path": "rs/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-db')].version"
        },
        {
          "type": "toml",
          "path": "rs/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-engine')].version"
        },
        {
          "type": "toml",
          "path": "rs/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-core')].version"
        },
        {
          "type": "toml",
          "path": "rs/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-api')].version"
        },
        {
          "type": "toml",
          "path": "rs/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-extras')].version"
        },
        {
          "type": "toml",
          "path": "rs/app/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-types')].version"
        },
        {
          "type": "toml",
          "path": "rs/app/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-db')].version"
        },
        {
          "type": "toml",
          "path": "rs/app/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-engine')].version"
        },
        {
          "type": "toml",
          "path": "rs/app/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-core')].version"
        },
        {
          "type": "toml",
          "path": "rs/app/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-api')].version"
        },
        {
          "type": "toml",
          "path": "rs/app/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-extras')].version"
        },
        {
          "type": "toml",
          "path": "rs/app/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='afudm-app')].version"
        },
        {
          "type": "json",
          "path": "rs/app/tauri.conf.json",
          "jsonpath": "$.version"
        }
      ],
      "include-component-in-tag": false
    }
  }
}
