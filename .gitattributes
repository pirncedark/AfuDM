# Satir sonlari: depoda LF, calisma agacinda LF. Windows kabuk betikleri CRLF kalir.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
*.jpg binary
*.jpeg binary
*.png binary
*.ico binary
*.exe binary
*.zip binary
*.mp3 binary
*.mp4 binary

# Documentation and test harnesses are not shipped product code.
docs/** linguist-documentation
rs/docs/** linguist-documentation
rs/tests_hata/** linguist-vendored
tests/** linguist-vendored
