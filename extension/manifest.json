{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "description": "__MSG_appDesc__",
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "notifications",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "icons": {
    "128": "icon128.png"
  },
  "default_locale": "tr"
}
