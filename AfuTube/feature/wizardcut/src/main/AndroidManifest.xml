<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- mediaProcessing is API 35+; Android 14 (API 34) requires a type it
         recognizes at startForeground or it throws. dataSync is the
         documented fallback type for media-processing services on API 34. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        android:maxSdkVersion="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- AfuTube içinde kütüphane: Application/ikon/tema/yedek ayarları AfuTube'un. -->
    <application>

        <property
            android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_SPLITS_ENABLED"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="false"
            tools:ignore="AppLinkUrlError"
            android:intentMatchingFlags="enforceIntentFilter"
            android:resizeableActivity="true"
            android:theme="@style/Theme.WizardCut"
            android:windowSoftInputMode="adjustResize">
            <!-- Explicit launcher/dynamic shortcuts must still match a declared
                 action when Android 16 strict intent matching is enabled. -->
            <intent-filter>
                <action android:name="info.bigwizardmedia.wizardcut.action.NEW_PROJECT" />
                <action android:name="info.bigwizardmedia.wizardcut.action.OPEN_RECENT" />
                <action android:name="info.bigwizardmedia.wizardcut.action.RESUME_RECOVERED" />
                <action android:name="info.bigwizardmedia.wizardcut.action.OPEN_LAST_PROJECT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- Non-media document receiver for ClearCut-owned plugin,
                 template, LUT, archive, timeline-interchange, and caption files.
                 Kept to explicit MIME families plus content:// VIEW grants;
                 MainActivity still validates extension, size, and parser
                 status before showing a preview/report. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="application/octet-stream" />
                <data
                    android:scheme="content"
                    android:mimeType="application/json" />
                <data
                    android:scheme="content"
                    android:mimeType="application/zip" />
                <data
                    android:scheme="content"
                    android:mimeType="application/xml" />
                <data
                    android:scheme="content"
                    android:mimeType="text/xml" />
                <data
                    android:scheme="content"
                    android:mimeType="text/plain" />
                <data
                    android:scheme="content"
                    android:mimeType="text/vtt" />
                <data
                    android:scheme="content"
                    android:mimeType="text/x-subrip" />
                <data
                    android:scheme="content"
                    android:mimeType="application/x-subrip" />
                <data
                    android:scheme="content"
                    android:mimeType="text/srt" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/vtt" />
                <data android:mimeType="text/x-subrip" />
                <data android:mimeType="application/x-subrip" />
                <data android:mimeType="text/srt" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/vtt" />
                <data android:mimeType="text/x-subrip" />
                <data android:mimeType="application/x-subrip" />
                <data android:mimeType="text/srt" />
            </intent-filter>
            <!-- Image share target: bring a sticker / overlay candidate in
                 from another app. `content://` only so a malicious third
                 party can't hand us a `file://` path outside our sandbox. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="image/*" />
            </intent-filter>
            <!-- Audio share target: drop music / SFX / voiceover from another
                 app onto the audio track. Same `content://` only policy. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".engine.ExportService"
            android:foregroundServiceType="mediaProcessing|dataSync"
            android:exported="false" />

        <!-- Disable default WorkManager initializer (using Hilt HiltWorkerFactory) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- FileProvider AfuTube'un (${applicationId}.fileprovider); WizardCut yolları AfuTube file_paths.xml'e eklendi. -->

    </application>
</manifest>
